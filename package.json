{
  "name": "x32-bus-aux-control",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android --mode developDebug --appIdSuffix develop",
    "android:clean": "powershell -ExecutionPolicy Bypass -File scripts/android-reset-gradle-cache.ps1",
    "assemble:android": "bash ./android/assembleHomologRelease.sh",
    "bundle:android": "bash ./android/bundleRelease.sh",
    "icons": "node scripts/generate-icons.js",
    "ios": "react-native run-ios --mode Debug",
    "start": "react-native start",
    "pod": "bash ./pod-install.sh",
    "postinstall": "husky && npm run pod",
    "prepare": "husky",
    "test": "jest",
    "test:ci": "jest --ci --coverage --runInBand",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint . --cache --cache-location .eslintcache --ext .ts,.tsx",
    "lint:ci": "eslint . --cache --cache-location .eslintcache-ci --ext .ts,.tsx",
    "tsc": "tsc --noEmit",
    "tsc:ci": "tsc --noEmit --pretty false",
    "lint:tsc:ci": "run-p lint:ci tsc:ci"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "4.5.7",
    "@react-navigation/native": "6.1.18",
    "@react-navigation/native-stack": "6.11.0",
    "buffer": "6.0.3",
    "lottie-react-native": "7.3.6",
    "react": "19.0.0",
    "react-native": "0.78.1",
    "react-native-gesture-handler": "2.31.2",
    "react-native-keep-awake": "4.0.0",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.9.1",
    "react-native-svg": "15.15.4",
    "react-native-udp": "4.1.7"
  },
  "devDependencies": {
    "@babel/core": "7.25.2",
    "@babel/preset-env": "7.25.4",
    "@babel/runtime": "7.25.0",
    "@react-native-community/cli": "15.0.0",
    "@react-native/babel-preset": "0.78.1",
    "@react-native/eslint-config": "0.78.1",
    "@react-native/metro-config": "0.78.1",
    "@react-native/typescript-config": "0.78.1",
    "@testing-library/react-native": "12.5.2",
    "@types/jest": "29.5.12",
    "@types/node": "22.5.1",
    "@types/react": "19.0.0",
    "@types/react-native-keep-awake": "2.0.8",
    "@types/react-test-renderer": "19.0.0",
    "babel-plugin-module-resolver": "5.0.3",
    "eslint-config-prettier": "8.10.0",
    "eslint-plugin-prettier": "4.2.1",
    "husky": "9.1.7",
    "jest": "29.7.0",
    "npm-run-all": "4.1.5",
    "prettier": "2.8.8",
    "react-test-renderer": "19.0.0",
    "sharp": "0.34.5",
    "ts-jest": "29.2.4",
    "typescript": "5.5.4"
  },
  "engines": {
    "node": ">=18"
  }
}
